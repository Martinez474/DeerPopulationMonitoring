# Canopies near three deer make cover observable in visual and thermal modes.
# The thermal controller uses their bounding-sphere radius and foliage density.
DEF THERMAL_SHRUB_1 Solid {
  translation 23888 17016.2 203.126
  name "sparse survey shrub"
  children [
    Transform {
      translation 0 0 1.8
      scale 2.6 2.6 2.2
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.23 0.34 0.12
            roughness 1
          }
          geometry Sphere { radius 1 }
        }
      ]
    }
  ]
  boundingObject Pose {
    translation 0 0 1.8
    children [ Sphere { radius 2.6 } ]
  }
}
