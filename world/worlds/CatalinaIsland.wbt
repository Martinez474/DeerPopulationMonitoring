Mavic2Pro {
  # Start west of the first deer with the pitched camera aimed at it.
  translation 23868 17007 220
  rotation 0 0 1 0
  name "Wildlife survey drone"
  controller "drone_tracker"
  supervisor TRUE
  cameraSlot [
    Camera {
      name "camera"
      fieldOfView 1.0472
      width 960
      height 540
      near 0.2
      far 500
      antiAliasing TRUE
      recognition Recognition {
        maxRange 250
        maxObjects -1
        occlusion 1
        frameColor 0.2 1 0.2
        frameThickness 5
      }
    }
  ]
}
