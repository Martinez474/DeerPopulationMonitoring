Mavic2Pro {
  translation 34988.9 15793.9 18.2
  name "Wildlife survey drone"
  controller "drone_startup"
  supervisor TRUE
  cameraSlot [
    Camera {
      name "camera"
      fieldOfView 1.0472
      width 640
      height 360
      near 0.2
      far 500
      antiAliasing FALSE
      recognition Recognition {
        maxRange 250
        maxObjects -1
        occlusion 1
        segmentation TRUE
        frameColor 0.2 1 0.2
        frameThickness 5
      }
    }
    RangeFinder {
      name "thermal depth"
      fieldOfView 1.0472
      width 256
      height 144
      near 0.2
      minRange 0.2
      maxRange 500
    }
    Display {
      translation 0 0 1000
      name "thermal display"
      width 256
      height 144
      children [
        # In thermal mode the panel is 0.5 m behind the sensing camera and
        # 0.6 m in front of the viewpoint. Webots cameras look along +X.
        Shape {
          appearance Appearance {
            texture ImageTexture {
              url []
              filtering 0
            }
          }
          geometry Box {
            size 0.002 0.7 0.394
          }
        }
      ]
    }
  ]
}
