WorldInfo {
  info [
    "Manual wildlife survey with a drone camera and visual deer counting."
    "Click the 3D view and use the keyboard controls printed by the drone controller."
  ]
  title "Catalina Island deer monitoring"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
